{
  "name": "stalwart-webui-fork",
  "private": true,
  "version": "1.0.8",
  "description": "Stalwart WebUI Fork",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
